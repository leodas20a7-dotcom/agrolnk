# ==============================================================================
# AgroLnk Environment Variables Template
# Copy this file to .env and fill in your local or production values.
# IMPORTANT: Never commit .env or include it in distributed archives (.zip).
# ==============================================================================

# Supabase Public API Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Razorpay Client Publishable Key ID (Safe for public browser checkout)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# AgroLnk Official Escrow & Virtual Collection Bank Configuration
# (Replace with your company's actual bank-registered details)
VITE_AGROLNK_ESCROW_ACCOUNT_NAME=AGROLNK PRIVATE LIMITED
VITE_AGROLNK_ESCROW_ACCOUNT_NUMBER=your_bank_account_number
VITE_AGROLNK_ESCROW_IFSC=your_bank_ifsc
VITE_AGROLNK_ESCROW_BANK_NAME=your_bank_name
VITE_AGROLNK_ESCROW_BRANCH=your_bank_branch
VITE_AGROLNK_VAN_PREFIX=AGRO


# ------------------------------------------------------------------------------
# SECURITY NOTICE:
# Server-side secrets (such as RAZORPAY_KEY_SECRET and SUPABASE_SERVICE_ROLE_KEY)
# must NEVER be added to this file or the client repository.
# Configure server secrets exclusively via Supabase Secrets:
#   supabase secrets set RAZORPAY_KEY_SECRET=your_secret_here
# ------------------------------------------------------------------------------
