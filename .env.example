# =============================================================================
# AgroLnk Production & Staging Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CLIENT-SIDE VARIABLES (Exposed to Vite Frontend via import.meta.env)
# -----------------------------------------------------------------------------
# Your Supabase Project API URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Anonymous Public Key (safe for browser)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Razorpay Standard Checkout Key ID (public test or live key)
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyHere

# Optional: Mapbox / Leaflet Geocoding API Key (if using live GPS routing)
# VITE_MAPBOX_TOKEN=pk.your-mapbox-token-here

# -----------------------------------------------------------------------------
# 2. SERVER-SIDE & SUPABASE EDGE FUNCTION SECRETS (NEVER EXPOSE IN FRONTEND!)
# Set these via Supabase CLI (`supabase secrets set KEY=VALUE`) or Supabase Dashboard
# -----------------------------------------------------------------------------
# Supabase Service Role Key (Bypasses RLS for authoritative server operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Razorpay Route Marketplace Settlement Keys
RAZORPAY_KEY_ID=rzp_test_YourKeyHere
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-here

# Razorpay Webhook Secret (configured in Razorpay Dashboard -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret-here
